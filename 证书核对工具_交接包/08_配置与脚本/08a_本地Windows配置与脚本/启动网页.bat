@echo off
REM ============================================================
REM 启动网页.bat
REM 作用: ★ 启动网页版（依赖已装好时用）：上传→选列→核对→标红下载
REM 用法: 直接双击
REM 顺序: 按文件名数字从小到大跑 —— 0_看介绍文档.bat → 1_安装依赖.bat → 2_网络自检.bat → 3_查看表格列结构.bat → 4_试跑10条.bat → 5_全量核对.bat → 6_UL登录（首次）.bat → 9_自测（验证程序本身）.bat → 一键启动.bat → 启动网页.bat
REM 说明文档: 使用说明.md / 文件清单.md
REM ============================================================
chcp 65001 >nul
cd /d "%~dp0"
call "%~dp0_py.bat"
echo ============================================================
echo   证书核对 · 网页版
echo   稍等几秒，浏览器会自动打开 http://127.0.0.1:8756
echo.
echo   ★★ 本窗口是后台服务，使用期间请【不要关闭】这个黑窗口！
echo      关掉它网页就打不开了。用完再关。
echo.
echo   查 VDE 需先开 VPN/加速器；查 UL 在网页上点「UL 登录」先登一次。
echo ============================================================
echo.
%PYEXE% -m cert_verify.web
echo.
echo 服务已结束。按任意键关闭本窗口。
pause >nul
