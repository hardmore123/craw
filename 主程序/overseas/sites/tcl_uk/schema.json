{
  "anchor": "h1",
  "search": {
    "container": "a[href*='/uk/en/tvs/']",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 5000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 40,
      "fallback_per_model": true
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[data-testid='brand']",
        "meta[itemprop='brand']"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "selectors": [
        "h1"
      ],
      "regex": "\\b([A-Z0-9][A-Z0-9-]{3,20})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "link[rel='canonical']"
      ],
      "attr": "href",
      "regex": "/tvs/([^/]+)/?",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "feefo",
    "feefo": {
      "merchant_identifier": "tcl-technology",
      "origin": "www.tcl.com",
      "locale": "en_GB",
      "since_period": "ALL",
      "summary_api": "https://api.feefo.com/api/10/reviews/summary/product?product_sku={product_sku}&origin=www.tcl.com&merchant_identifier=tcl-technology&since_period=ALL",
      "reviews_api": "https://api.feefo.com/api/10/reviews/product?product_sku={product_sku}&origin=www.tcl.com&merchant_identifier=tcl-technology&since_period=ALL&page_size=100&page={page}",
      "product_sku_from": "URL 末段 slug 大写（url.rstrip('/').rsplit('/',1)[-1].upper()）",
      "page_size": 100,
      "max_pages": 20,
      "max_reviews": 2000
    },
    "container": "[class*='feefo'], [data-feefo]",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "data-review-id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']",
          "[class*='feefo-rating']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='feefo-title']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='feefo-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']",
          "[class*='feefo-author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']",
          "[class*='feefo-date']"
        ],
        "transform": "clean_text"
      }
    }
  },
  "summary": {
    "avg_rating": {
      "selectors": [
        "[class*='feefo'] .rating",
        "[data-testid='rating']"
      ],
      "transform": "rating"
    },
    "total_count": {
      "selectors": [
        "[class*='feefo'] .count",
        "[data-testid='review-count']"
      ],
      "transform": "int"
    }
  },
  "match": {
    "strategy": "url_template",
    "url_template": "https://www.tcl.com/uk/en/tvs/{slug}",
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3
    },
    "reject": {
      "title_contains_any": [
        "soundbar",
        "projector",
        "wall mount",
        "mount",
        "bracket",
        "stand",
        "case",
        "cover",
        "remote"
      ]
    },
    "on_no_match": "skip"
  }
}
