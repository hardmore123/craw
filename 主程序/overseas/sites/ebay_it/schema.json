{
  "anchor": "h1, script[type='application/ld+json']",
  "search": {
    "container": "a.s-item__link, a[href*='/itm/']",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 6000,
    "scroll_passes": 3,
    "batch": {
      "keyword_template": "{brand} tv",
      "threshold": 40,
      "force": true,
      "fallback_per_model": false,
      "max_candidates": 60,
      "max_search_failures": 2,
      "min_candidates": 5,
      "retries": 3
    }
  },
  "price": {
    "currency": "EUR",
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "[data-price]",
        ".price",
        "[class*='price']"
      ]
    },
    "raw_text": {
      "selectors": [
        "[class*='price']",
        ".price"
      ]
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "verify": {
      "require_model_in": [
        "title"
      ]
    },
    "on_no_match": "skip"
  }
}