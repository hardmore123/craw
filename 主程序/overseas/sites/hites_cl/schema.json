{
  "anchor": "h1",
  "search": {
    "container": "a.product-item-link, .product-tile",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 6000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 40,
      "fallback_per_model": true
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        ".product-price .sales .value",
        ".price-sales"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']",
        "meta[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        ".product-price .strike .value",
        ".price-list"
      ],
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[itemprop='availability']",
        ".availability-msg"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "transform": "clean_text"
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        ".product-name"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[itemprop='brand']",
        "meta[itemprop='brand']"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9._\\-]{1,39})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[itemprop='sku']",
        "meta[itemprop='sku']",
        "[data-product-id]"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "verificado_ai_api",
    "seller_token": "lxYg9hRtmvWOlJyJxOFE5PezUh50XWlDp6ZVlqJytNWATHbyd8n6zykmadOc",
    "container": "[class*='review'], [itemprop='review']",
    "limit": 40,
    "fields": {
      "review_key": {
        "_note": "verificado 无站内 id → sha1(sku|author|date|rating|text)[:16] 前缀 hites_verificado:"
      },
      "rating": {
        "jsonld": "rating",
        "transform": "rating"
      },
      "title": {
        "_note": "verificado 无标题字段"
      },
      "body": {
        "jsonld": "text",
        "transform": "clean_text"
      },
      "author": {
        "jsonld": "author",
        "transform": "clean_text"
      },
      "review_date": {
        "jsonld": "date",
        "transform": "clean_text"
      }
    }
  },
  "summary": {
    "_note": "用 API 的 average_rating + total_reviews；stars 由 reviews_jsonld 实算（不依赖 API 直方图）",
    "avg_rating": {
      "jsonld": "average_rating",
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "total_reviews",
      "transform": "int"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3,
      "core_strip_suffix": [
        "pro",
        "max"
      ]
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto",
        "remote",
        "bracket",
        "case",
        "cover",
        "soundbar",
        "barra de sonido",
        "parlante",
        "bocina",
        "proyector",
        "projector",
        "rack",
        "antena",
        "cleaner",
        "limpiador",
        "protector",
        "pantalla"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  }
}
