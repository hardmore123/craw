{
  "anchor": "h1",
  "search": {
    "container": "a[href*='/produkt-'], .product-card, [class*='product']",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "batch": {
      "keyword_template": "{brand} telewizor",
      "max_candidates": 60,
      "fallback_per_model": true
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "[itemprop='price']",
        ".price",
        "[class*='price']"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[itemprop='availability']"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "transform": "clean_text"
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[itemprop='brand']",
        "meta[itemprop='brand']"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "selectors": [
        "[itemprop='model']",
        "[data-testid*='model']"
      ],
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[itemprop='sku']",
        "meta[itemprop='sku']"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "jsonld",
    "container": "[itemprop='review'], [class*='review'], [data-testid*='review']",
    "limit": 40,
    "jsonld": {
      "product_type": "Product",
      "aggregateRating": "aggregateRating",
      "review_array": "review",
      "field_map": {
        "review_key": "datePublished|author.name",
        "rating": "reviewRating.ratingValue",
        "title": "name",
        "body": "description",
        "author": "author.name",
        "review_date": "datePublished"
      }
    },
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[itemprop='name']",
          "[class*='review-title']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']"
        ],
        "transform": "clean_text"
      }
    }
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "selectors": [
        "[itemprop='ratingValue']"
      ],
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "selectors": [
        "[itemprop='reviewCount']"
      ],
      "transform": "int"
    }
  },
  "specs": [],
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 60,
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3,
      "core_size_tokens": [
        "class",
        "inch",
        "in",
        "\"",
        "cali",
        "series"
      ]
    },
    "reject": {
      "title_contains_any": [
        "soundbar",
        " uchwyt",
        "uchwyt ",
        "montaż",
        "wieszak",
        "kabel",
        "pilot",
        "akcesoria",
        "wall mount",
        "mount",
        "bracket",
        "stand",
        "case",
        "cover",
        "cable",
        "adapter",
        "proyector",
        "projektor",
        "ekran"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  }
}
