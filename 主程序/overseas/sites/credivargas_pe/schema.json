{
  "anchor": "h1",
  "search": {
    "container": "a[href*='/p'], a[href*='/pdp/']",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true,
      "transform": "clean_text"
    },
    "url": {
      "self_attr": "href"
    },
    "batch": {
      "max_candidates": 60
    }
  },
  "price": {
    "price": {
      "selectors": [
        "[class*='price'][class*='selling']",
        "[class*='selling-price']",
        ".precio-producto"
      ],
      "transform": "money",
      "jsonld": "offers.price"
    },
    "currency": {
      "selectors": [
        "[itemprop='priceCurrency']",
        "meta[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency",
      "jsonld": "offers.priceCurrency"
    },
    "list_price": {
      "selectors": [
        "[class*='list-price']",
        "s",
        "del",
        "[class*='old-price']"
      ],
      "transform": "money",
      "jsonld": "offers.highPrice"
    },
    "in_stock": {
      "selectors": [
        "[itemprop='availability']",
        "button[class*='add-to-cart']:not([disabled])"
      ],
      "attr": "content",
      "transform": "in_stock",
      "jsonld": "offers.availability"
    },
    "raw_text": {
      "selectors": [
        "[class*='price']"
      ],
      "transform": "clean_text"
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        "[class*='product-name']",
        "[data-testid*='name']"
      ],
      "transform": "clean_text",
      "jsonld": "name"
    },
    "brand": {
      "selectors": [
        "[class*='brand']",
        "meta[itemprop='brand']"
      ],
      "attr": "content",
      "transform": "brand",
      "jsonld": "brand.name"
    },
    "model": {
      "kv": {
        "container": "table tr, .product-specification tr, [class*='specification'] tr",
        "key_contains": "modelo",
        "value": "td:nth-child(2)"
      },
      "transform": "clean_text",
      "jsonld": "mpn"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[itemprop='sku']",
        "meta[itemprop='sku']",
        "[data-sku]"
      ],
      "attr": "content",
      "transform": "clean_text",
      "jsonld": "sku"
    }
  },
  "reviews": {
    "source": "none",
    "container": "[class*='review'], [data-testid*='review'], [itemprop='review'], [class*='comentario']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']",
          "[class*='rating']",
          "[class*='star']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']",
          "[class*='titulo']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']",
          "[class*='comentario']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']",
          "[class*='author']",
          "[class*='reviewer']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']",
          "[class*='date']",
          "[class*='fecha']"
        ],
        "transform": "clean_text"
      },
      "verified": {
        "selectors": [
          "[class*='verified']",
          "[class*='verificado']"
        ],
        "transform": "bool_present"
      }
    },
    "_vtex_reviews": {
      "endpoint": "https://www.credivargas.pe/_v/public/graphql/v1?workspace=master&maxAge=30&appsEtag=remove&domain=store&locale=es-PE&__bindingId=2e202a95-18c0-4827-863f-ff9614db2c32",
      "app_version": "vtex.reviews-and-ratings@3.20.1",
      "query_mode": "persistedQuery (GET 端点, extensions.variables base64 编码 {productId:sku})",
      "total_hash": "a626a91c1e3cfc874e72632c0768c5033720c1f322a01562a4ea5d0191d4179b",
      "average_hash": "206747751fcb514a87ebba4fe89e8d26250e7a759bdf24a83f8055b8cdf2d06d",
      "bindingId": "2e202a95-18c0-4827-863f-ff9614db2c32",
      "note": "Grupo Vargas 集团; GET 端点+base64 variables; 全站0/53网评"
    },
    "reason": "已确认全站零评价：REST /reviews-and-ratings/api/reviews 200 + total=0（app 已装）。_partial_reviews_fix 复确认。capabilities 移除 reviews。"
  },
  "summary": {
    "avg_rating": {
      "selectors": [
        "[itemprop='ratingValue']",
        "[class*='rating-value']",
        "[class*='average-rating']"
      ],
      "transform": "rating",
      "jsonld": "aggregateRating.ratingValue"
    },
    "total_count": {
      "selectors": [
        "[itemprop='reviewCount']",
        "[class*='review-count']",
        "[class*='total-review']"
      ],
      "transform": "int",
      "jsonld": "aggregateRating.reviewCount"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "core_strip_suffix": [
        "pro",
        "max"
      ],
      "min_core_len": 3
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "rack",
        "stand",
        "mount",
        "bracket",
        "control remoto",
        "cable",
        "adaptador",
        "accesorio",
        "funda",
        "base",
        "soporte para tv",
        "barra de sonido",
        "soundbar",
        "proyector",
        "parlante",
        "bocina"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  }
}
