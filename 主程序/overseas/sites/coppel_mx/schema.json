{
  "anchor": "h1",
  "search": {
    "container": "a.cpl-card__body[href*='/pdp/']",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "selectors": [
        "[data-testid*='product'][data-testid*='name']",
        "h3",
        "h2"
      ],
      "transform": "clean_text"
    },
    "url": {
      "self_attr": "href"
    },
    "batch": {
      "max_candidates": 60
    }
  },
  "price": {
    "price": {
      "selectors": [
        "[data-testid='pdp_discounted_price']",
        "[data-testid='pdp_price']"
      ],
      "transform": "money",
      "jsonld": "offers.price"
    },
    "currency": {
      "selectors": [
        "[data-testid='pdp_discounted_price']",
        "[data-testid='pdp_price']"
      ],
      "transform": "currency_mx",
      "jsonld": "offers.priceCurrency"
    },
    "list_price": {
      "selectors": [
        "[data-testid='pdp_price']",
        "[data-testid='pdp_list_price']",
        "s",
        "del"
      ],
      "transform": "money"
    },
    "in_stock": {
      "selectors": [
        "button[data-testid='add_to_cart_modal_cta']:not([disabled]):not([aria-disabled='true'])"
      ],
      "transform": "bool_present",
      "jsonld": "offers.availability"
    },
    "raw_text": {
      "selectors": [
        "[data-testid='pdp_price_details']",
        "[data-testid='pdp_discounted_price']"
      ],
      "transform": "clean_text"
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        "[data-testid='pdp_product_name']"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [],
      "transform": "brand",
      "jsonld": "brand.name"
    },
    "model": {
      "kv": {
        "container": "table tr",
        "key_contains": "modelo",
        "value": "td:nth-child(2)"
      },
      "transform": "clean_text",
      "jsonld": "model"
    },
    "size": {
      "selectors": [
        "h1",
        "[data-testid='pdp_product_name']"
      ],
      "kv": {
        "container": "table tr",
        "key_contains": "tamaño en pulgadas",
        "value": "td:nth-child(2)"
      },
      "transform": "size_inch"
    }
  },
  "reviews": {
    "container": "[data-testid*='review'], .pr-review, article[class*='review'], [itemprop='review']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[data-testid*='rating']",
          ".pr-rating-stars",
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[data-testid*='review-title']",
          ".pr-rd-review-headline",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[data-testid*='review-text']",
          ".pr-rd-description-text",
          "[itemprop='reviewBody']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[data-testid*='author']",
          ".pr-rd-author-nickname",
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[data-testid*='date']",
          ".pr-rd-review-date",
          "[itemprop='datePublished']"
        ],
        "transform": "clean_text"
      },
      "helpful_count": {
        "selectors": [
          "[data-testid*='helpful']",
          ".pr-helpful-count"
        ],
        "transform": "int"
      },
      "review_url": {
        "selectors": []
      }
    },
    "media": {
      "images": {
        "selector": "[data-testid*='review'] img, .pr-review img",
        "attr": "src",
        "exclude": [
          "avatar",
          "icon"
        ],
        "limit": 30
      },
      "videos": {
        "selector": "[data-testid*='review'] video source, .pr-review video source",
        "attr": "src",
        "limit": 10
      }
    }
  },
  "summary": {
    "avg_rating": {
      "selectors": [
        "[data-testid*='rating']",
        "[itemprop='ratingValue']"
      ],
      "transform": "rating",
      "jsonld": "aggregateRating.ratingValue"
    },
    "total_count": {
      "selectors": [
        "[data-testid*='review-count']",
        "[itemprop='reviewCount']"
      ],
      "transform": "int",
      "jsonld": "aggregateRating.reviewCount"
    }
  },
  "specs": [
    {
      "type": "table",
      "container": "table tr",
      "key": "td:first-child",
      "value": "td:nth-child(2)",
      "limit": 160
    }
  ],
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "sku",
        "title"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "core_strip_suffix": [
        "pro",
        "max"
      ],
      "min_core_len": 4
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "control remoto",
        "funda",
        "cable",
        "adaptador",
        "accesorio"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  }
}
