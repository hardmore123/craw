{
  "anchor": "h1",
  "search": {
    "container": "a[href*='.html']",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "selectors": [
        ".product-name",
        "h2",
        "h3"
      ],
      "transform": "clean_text"
    },
    "url": {
      "self_attr": "href"
    },
    "batch": {
      "max_candidates": 60
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        ".price",
        "[class*='product-price']"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        "[class*='list-price']",
        "[class*='old-price']",
        "[class*='was-price']",
        "[class*='original-price']",
        "[class*='strike']",
        "s",
        "del"
      ],
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[itemprop='availability']",
        "button[class*='add-to-cart']:not([disabled])",
        "button[class*='buy']:not([disabled])",
        "[data-testid*='add-to-cart']:not([disabled])",
        "[class*='in-stock']",
        "[class*='disponible']"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "selectors": [
        "[class*='price']",
        "[itemprop='price']",
        "[data-price]"
      ],
      "transform": "clean_text"
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[class*='brand']",
        "[data-brand]"
      ],
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9-]{4,20})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "jsonld": "sku",
      "selectors": [
        "[itemprop='sku']"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "feefo_api",
    "feefo": {
      "merchant_identifier": "marks-electrical",
      "origin": "markselectrical.co.uk",
      "summary_endpoint": "https://api.feefo.com/api/10/reviews/summary/product?product_sku={sku}&merchant_identifier=marks-electrical&origin=markselectrical.co.uk&since_period=ALL",
      "reviews_endpoint": "https://api.feefo.com/api/10/reviews/product?product_sku={sku}&merchant_identifier=marks-electrical&origin=markselectrical.co.uk&since_period=ALL&full_thread=include&page={page}",
      "page_size": 20,
      "max_pages": 20,
      "_note": "纯HTTP直连无需浏览器; product_sku=DB product.sku(如4T-C50HM5245KB)1:1; 跨商户聚合"
    },
    "container": ".feefo-review, [class*='review-item']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[class*='rating']",
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']",
          "[class*='reviewer']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']",
          "time"
        ],
        "transform": "clean_text"
      },
      "verified": {
        "selectors": [
          "[class*='verified']"
        ],
        "transform": "bool_present"
      }
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title",
        "sku"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "core_strip_suffix": [
        "pro",
        "max"
      ],
      "min_core_len": 4
    },
    "reject": {
      "title_contains_any": [
        "stand",
        "mount",
        "bracket",
        "cable",
        "wall mount",
        "soundbar"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  }
}
