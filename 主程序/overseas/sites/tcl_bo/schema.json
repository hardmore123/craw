{
  "anchor": "h1, .product-card-item",
  "search": {
    "container": ".product-card-item",
    "sku": {
      "selectors": [
        "li[data-code]"
      ],
      "attr": "data-code"
    },
    "title": {
      "selectors": [
        ".title.product-title-underline",
        ".card-item-info-item",
        "h1",
        "h2"
      ],
      "transform": "clean_text"
    },
    "url": {
      "selectors": [
        "a[href*='/tvs/']"
      ],
      "attr": "href"
    },
    "wait_ms": 5000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 60,
      "fallback_per_model": true
    }
  },
  "price": {
    "price": {
      "selectors": [
        ".price",
        "[data-price]",
        ".product-price",
        ".buy-price"
      ],
      "transform": "money"
    },
    "currency": {
      "selectors": [
        "[data-currency]",
        "meta[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency"
    },
    "list_price": {
      "selectors": [
        "del .price",
        ".original-price",
        "s"
      ],
      "transform": "money"
    },
    "in_stock": {
      "selectors": [
        "[data-availability]",
        ".stock",
        ".buy-link-item a"
      ],
      "transform": "in_stock"
    },
    "raw_text": {
      "selectors": [
        ".price",
        ".buy-link-item"
      ],
      "transform": "clean_text"
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        ".product-detail-title",
        ".title"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "meta[itemprop='brand']",
        "[data-brand]"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "selectors": [
        "[data-code]",
        "[data-model]",
        "[itemprop='model']"
      ],
      "attr": "data-code",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1",
        ".title"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[data-code]",
        "li[data-code]"
      ],
      "attr": "data-code",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "container": ".review, [itemprop='review'], .comment",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          ".star-rating",
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          ".review-title",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          ".review-body",
          "[itemprop='reviewBody']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          ".review-author",
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          ".review-date",
          "time",
          "[itemprop='datePublished']"
        ],
        "transform": "clean_date"
      }
    }
  },
  "summary": {
    "avg_rating": {
      "selectors": [
        ".star-rating",
        "[itemprop='ratingValue']"
      ],
      "transform": "rating"
    },
    "total_count": {
      "selectors": [
        ".review-count",
        "[itemprop='reviewCount']"
      ],
      "transform": "int"
    }
  },
  "specs": [],
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "title"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "core_strip_suffix": [
        "pro",
        "max"
      ],
      "min_core_len": 3
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto",
        "remote",
        "bracket",
        "case",
        "cover",
        "soundbar",
        "barra de sonido",
        "parlante",
        "bocina",
        "proyector",
        "rack",
        "antena"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  }
}
