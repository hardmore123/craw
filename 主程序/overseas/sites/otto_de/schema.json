{
  "anchor": "h1",
  "search": {
    "container": "a[href*='/product'], a[href*='/produkt'], a[href*='/p/'], a[class*='product']",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 6000,
    "scroll_passes": 3,
    "batch": {
      "keyword_template": "{brand} fernseher",
      "threshold": 40,
      "force": true,
      "fallback_per_model": false,
      "max_candidates": 60,
      "max_search_failures": 2,
      "min_candidates": 5,
      "retries": 3
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "[data-testid*='price']",
        "[class*='price']"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[itemprop='availability']"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "transform": "clean_text"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        "[class*='list-price']",
        "[class*='old-price']",
        "[class*='was-price']",
        "[class*='original-price']",
        "[class*='strike']",
        "s",
        "del"
      ],
      "transform": "money"
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "meta[itemprop='brand']",
        "[data-testid*='brand']"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "selectors": [
        "[itemprop='model']",
        "[data-testid*='model']"
      ],
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[itemprop='sku']",
        "meta[itemprop='sku']"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "none",
    "container": "[itemprop='review'], [class*='review'], [data-testid*='review']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[itemprop='name']",
          "[class*='review-title']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']"
        ],
        "transform": "clean_text"
      }
    }
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "selectors": [
        "[itemprop='ratingValue']"
      ],
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "selectors": [
        "[itemprop='reviewCount']"
      ],
      "transform": "int"
    }
  },
  "specs": [],
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 60,
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "core_strip_suffix": [
        "pro",
        "max"
      ],
      "min_core_len": 3,
      "core_size_tokens": [
        "class",
        "inch",
        "in",
        "\"",
        "zoll",
        "series"
      ]
    },
    "reject": {
      "title_contains_any": [
        "soundbar",
        "soundbar",
        "projektor",
        "wandhalterung",
        "halterung",
        "standfuß",
        "kabel",
        "fernbedienung",
        "zubehör",
        "wall mount",
        "mount",
        "bracket",
        "stand",
        "case",
        "cover",
        "cable",
        "adapter",
        "screen protector"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  }
}
