{
  "anchor": "h1, script[type='application/ld+json']",
  "search": {
    "container": "[data-product-id], a[href*='/p/'], [class*='product-card'], article",
    "wait_ms": 5000,
    "scroll_passes": 3,
    "batch": {
      "max_candidates": 60,
      "max_pages": 20,
      "threshold": 10
    }
  },
  "price": {
    "selectors": [
      "[class*='price']",
      "[data-price]",
      ".price",
      "[itemprop='price']"
    ],
    "transform": "money",
    "jsonld": false
  },
  "match": {
    "verify": {
      "require_model_in": [
        "sku",
        "title"
      ],
      "allow_core_match": true,
      "min_core_len": 3
    },
    "on_no_match": "skip"
  }
}
