{
  "anchor": "body",
  "search": {
    "container": "body",
    "api_path": "/api/catalog_system/pub/products/search?ft={q}&_from={from}&_to={to}",
    "sku": {
      "self_attr": "productId"
    },
    "title": {
      "jsonld": "productName",
      "transform": "clean_text"
    },
    "url": {
      "jsonld": "link",
      "transform": "clean_text"
    },
    "batch": {
      "max_candidates": 60
    }
  },
  "price": {
    "price": {
      "jsonld": "items[0].sellers[0].commertialOffer.Price",
      "transform": "money"
    },
    "list_price": {
      "jsonld": "items[0].sellers[0].commertialOffer.ListPrice",
      "transform": "money"
    },
    "currency": {
      "jsonld": "items[0].sellers[0].commertialOffer.PriceCurrency",
      "transform": "currency"
    },
    "in_stock": {
      "jsonld": "items[0].sellers[0].commertialOffer.AvailableQuantity",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "selectors": [
        "[class*='price']",
        "[itemprop='price']",
        "[data-price]"
      ],
      "transform": "clean_text"
    }
  },
  "product": {
    "title": {
      "jsonld": "productName",
      "transform": "clean_text"
    },
    "brand": {
      "jsonld": "brand",
      "transform": "brand"
    },
    "model": {
      "regex": "\\b(\\d{1,4}[A-Z][A-Z0-9]{1,10})\\b",
      "transform": "clean_text"
    },
    "size": {
      "regex": "\\b(\\d{2})\\s*[ pulgadas inch]+\\b",
      "transform": "size_inch"
    },
    "sku": {
      "jsonld": "productId",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "none",
    "container": "[class*='review'], [itemprop='review']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='review-title']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='review-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']"
        ],
        "transform": "clean_text"
      }
    },
    "reason": "已确认全站零评价：REST /reviews-and-ratings/api/reviews 200 + total=0（app 已装）。_partial_reviews_fix 复确认。capabilities 移除 reviews。"
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 60,
    "verify": {
      "require_model_in": [
        "title",
        "sku"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "core_strip_suffix": [
        "pro",
        "max"
      ],
      "min_core_len": 3
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  }
}
