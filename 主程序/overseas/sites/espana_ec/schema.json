{
  "anchor": "h1, script[type='application/ld+json']",
  "search": {
    "container": "div.product-item, .product-card, li.item, [data-product-id]",
    "sku": {
      "self_attr": "data-product-id"
    },
    "title": {
      "selectors": [
        ".product-name a",
        ".product-title a",
        "h3 a",
        ".product-item-name a"
      ],
      "transform": "clean_text"
    },
    "url": {
      "self_attr": "href"
    },
    "batch": {
      "max_candidates": 60
    }
  },
  "price": {
    "currency": "USD",
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "[data-price]",
        ".price",
        "[class*='price']"
      ]
    },
    "raw_text": {
      "selectors": [
        "[class*='price']",
        ".price"
      ]
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "verify": {
      "require_model_in": [
        "title"
      ]
    },
    "on_no_match": "skip"
  }
}
