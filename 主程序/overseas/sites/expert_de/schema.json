{
  "anchor": "h1",
  "search": {
    "container": "a[href*='/shop/']",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 5000,
    "batch": {
      "keyword_template": "{brand} fernseher",
      "max_candidates": 60,
      "fallback_per_model": true,
      "_note": "搜索可能被 CF 拦，优先用 sitemap 发现"
    }
  },
  "price": {
    "price": {
      "selectors": [
        ".exp_price",
        "[class*='exp_price']"
      ],
      "transform": "money",
      "_note": "德语格式 513.99 / 1.299.- / 499,-；过滤 <50 的配件价"
    },
    "currency": {
      "selectors": [
        "[class*='exp_price']"
      ],
      "transform": "currency"
    },
    "list_price": {
      "selectors": [
        ".exp_price .formerPrice",
        "[class*='formerPrice']"
      ],
      "transform": "money"
    },
    "in_stock": {
      "selectors": [
        "[data-testid='add-to-cart']",
        ".in-stock"
      ],
      "transform": "in_stock"
    },
    "raw_text": {
      "selectors": [
        ".exp_price"
      ],
      "transform": "clean_text"
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        "title"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[data-testid='brand']",
        "meta[itemprop='brand']"
      ],
      "attr": "content",
      "transform": "brand",
      "_note": "标题正则词表匹配兜底（LG/Samsung/Sony/Philips/Metz/Loewe/Toshiba/TCL/Panasonic/Telefunken）"
    },
    "model": {
      "selectors": [
        "[data-testid='model']",
        "[itemprop='model']"
      ],
      "attr": "content",
      "regex": "\\b([A-Z0-9][A-Z0-9-]{4,20})\\b",
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch",
      "_note": "德语 (\\d{2,3})\\s*(Zoll|cm|inch)"
    },
    "sku": {
      "selectors": [
        "[data-testid='sku']",
        "[itemprop='sku']"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "bazaarvoice_blocked",
    "container": "[data-bv-show='inline_rating'], [class*='bv-content']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']",
          "[class*='bv-rating']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='bv-content-title']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='bv-content-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']",
          "[class*='bv-author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']",
          "[class*='bv-date']"
        ],
        "transform": "clean_text"
      }
    }
  },
  "summary": {
    "_note": "★评价区被 Cloudflare 拦截，BV 不 hydrate，summary 抓不到。needs_human。",
    "avg_rating": {
      "selectors": [
        "[data-bv-show='inline_rating'] .bv-rating",
        "[class*='bv-rating']"
      ],
      "transform": "rating"
    },
    "total_count": {
      "selectors": [
        "[data-bv-show='inline_rating'] .bv-count",
        "[class*='bv-count']"
      ],
      "transform": "int"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 60,
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3
    },
    "reject": {
      "title_contains_any": [
        "soundbar",
        "projektor",
        "wandhalterung",
        "halterung",
        "standfuß",
        "kabel",
        "fernbedienung",
        "zubehör"
      ]
    },
    "on_no_match": "skip"
  }
}
