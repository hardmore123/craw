{
  "anchor": "h1",
  "search": {
    "container": "div.product-item-pdc, .product-item-link",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 6000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 40,
      "fallback_per_model": true,
      "_note": "搜索相关性差：q=televisor 返回20条含2条非电视(支架/遥控)，按标题以 Televisor 开头过滤"
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "span.current-price",
        ".price"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "selectors": [
        "[itemprop='priceCurrency']",
        "meta[itemprop='priceCurrency']"
      ],
      "attr": "content",
      "transform": "currency"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        "span.before-price",
        ".old-price"
      ],
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[itemprop='availability']",
        ".stock"
      ],
      "attr": "content",
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "transform": "clean_text"
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1",
        ".page-title"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[itemprop='brand']",
        "meta[itemprop='brand']"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "regex": "\\b([A-Z0-9][A-Z0-9._\\-]{1,39})\\b",
      "transform": "clean_text",
      "_note": "型号在 SKU 里（去 K- 前缀），标题无型号"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[itemprop='sku']",
        "meta[itemprop='sku']",
        "[data-product-id]"
      ],
      "attr": "content",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "mageplaza_ajaxsort_http",
    "container": ".mp-review-item, .review-item",
    "limit": 40,
    "fields": {
      "review_key": {
        "selectors": [
          "[id^='review-item-']"
        ],
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          ".rating-result"
        ],
        "attr": "title",
        "transform": "rating",
        "_note": "title='NN%' 百分制，/20 转5星"
      },
      "title": {
        "selectors": [
          ".mp-review-title strong"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          ".mp-review-content"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          ".mp-review-author .mp-review-details-value"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          ".mp-review-date time"
        ],
        "attr": "datetime",
        "transform": "clean_text"
      },
      "helpful_count": {
        "selectors": [
          ".mp-review-helpful-value"
        ],
        "transform": "int"
      }
    }
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "transform": "rating",
      "_note": "百分制 0-100，需 /20 转5星"
    },
    "total_count": {
      "jsonld": "aggregateRating.ratingCount",
      "transform": "int"
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 40,
    "verify": {
      "require_model_in": [
        "sku",
        "title"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3,
      "core_strip_suffix": [
        "pro",
        "max"
      ]
    },
    "reject": {
      "title_contains_any": [
        "soporte",
        "mount",
        "stand",
        "cable",
        "adaptador",
        "control remoto",
        "remote",
        "bracket",
        "case",
        "cover",
        "soundbar",
        "barra de sonido",
        "parlante",
        "bocina",
        "proyector",
        "projector",
        "rack",
        "antena",
        "cleaner",
        "limpiador",
        "protector",
        "pantalla"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  }
}
