{
  "anchor": "h1",
  "search": {
    "container": "a[href*='/product/']",
    "sku": {
      "regex": "/en-ca/product/[^/]+/(\\d+)"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "url_template": "https://www.bestbuy.ca/en-ca/product/{sku}",
    "wait_ms": 8000,
    "scroll_passes": 12,
    "batch": {
      "keyword_template": "{brand} tv",
      "threshold": 40,
      "force": true,
      "fallback_per_model": false,
      "max_candidates": 60,
      "max_search_failures": 2
    }
  },
  "price": {
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "[data-automation='product-price']",
        ".productPricingContainer .price",
        "[itemprop='price']"
      ],
      "transform": "money"
    },
    "currency": {
      "jsonld": "offers.priceCurrency",
      "transform": "currency"
    },
    "list_price": {
      "jsonld": "offers.highPrice",
      "selectors": [
        "[data-automation='regular-price']",
        ".was-price"
      ],
      "transform": "money"
    },
    "in_stock": {
      "jsonld": "offers.availability",
      "selectors": [
        "[data-automation='add-to-cart']",
        "button.addToCartButton"
      ],
      "transform": "in_stock"
    },
    "raw_text": {
      "jsonld": "offers.price",
      "transform": "clean_text"
    }
  },
  "product": {
    "_note": "以 JSON-LD 为主（adapter.parse_product → retail_common.jsonld_product_payload）：name→title、brand.name→brand、mpn/sku/model→model、offers.price→price、aggregateRating→评分汇总。下面的 CSS 是 JSON-LD 缺失时的兜底，**未校准**。",
    "title": {
      "selectors": [
        "h1",
        "[data-automation='product-title']"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "jsonld": "brand.name",
      "selectors": [
        "[data-automation='brand-name']",
        "a[href*='/en-ca/brand/']"
      ],
      "transform": "brand"
    },
    "model": {
      "_note": "★闸三的权威来源。JSON-LD 的 mpn 优先；Best Buy CA 的商品页也会在规格表里写 Model。校准后若发现 JSON-LD 无 mpn，必须补规格表抽取，否则闸三不成立。",
      "jsonld": "mpn",
      "selectors": [
        "[data-automation='model-number']",
        "[data-automation='specifications'] tr"
      ],
      "regex": "Model\\s*(?:Number|No\\.?|#)?\\s*[:\\-]\\s*([A-Za-z0-9][A-Za-z0-9._\\-+/]{2,39})",
      "transform": "clean_text"
    },
    "category": {
      "selectors": [
        "[data-automation='breadcrumb'] li:last-child a"
      ],
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    }
  },
  "reviews": {
    "source": "bazaarvoice_bfd",
    "bv": {
      "client": "bestbuy-ca",
      "display_code": "18193",
      "site": "main_site",
      "locale": "en_CA",
      "origin": "https://www.bestbuy.ca",
      "content_locale": "en_CA,en_US,fr_CA",
      "page_size": 100,
      "max_pages": 10,
      "max_reviews": 100
    },
    "container": "[data-automation='review'], .review-item, [itemprop='review']",
    "limit": 40,
    "fields": {
      "review_key": {
        "_note": "JSON-LD 的 review @id 优先（retail_common 已实现）；DOM 路径取容器 id，缺则内容指纹兜底。",
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']",
          "[data-automation='review-rating']",
          ".reviewRating"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[data-automation='review-title']",
          "h3.reviewTitle"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[data-automation='review-comment']",
          ".reviewComment",
          "[itemprop='reviewBody']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[data-automation='review-author']",
          ".reviewAuthor"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "meta[itemprop='datePublished']",
          "[data-automation='review-date']"
        ],
        "attr": "content",
        "transform": "clean_text"
      },
      "helpful_count": {
        "selectors": [
          "[data-automation='helpful-count']"
        ],
        "transform": "int"
      },
      "verified": {
        "selectors": [
          "[data-automation='verified-purchase']"
        ],
        "transform": "bool_present"
      }
    }
  },
  "summary": {
    "avg_rating": {
      "jsonld": "aggregateRating.ratingValue",
      "selectors": [
        "[data-automation='rating'] [itemprop='ratingValue']",
        "[data-automation='average-rating']"
      ],
      "transform": "rating"
    },
    "total_count": {
      "jsonld": "aggregateRating.reviewCount",
      "selectors": [
        "[data-automation='review-count']",
        "[itemprop='reviewCount']"
      ],
      "transform": "int"
    }
  },
  "specs": [
    {
      "type": "table",
      "container": "[data-automation='specifications'] tr, .specifications-table tr",
      "key": "th, td:first-child",
      "value": "td:last-child",
      "limit": 150
    },
    {
      "type": "kvlist",
      "container": "[data-automation='specifications'] li, ul.specs li",
      "limit": 150
    }
  ],
  "match": {
    "strategy": "search_then_verify",
    "search_keyword_template": "{brand} {model}",
    "candidate_limit": 60,
    "verify": {
      "require_model_in": [
        "sku",
        "title",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "core_strip_suffix": [
        "pro",
        "max"
      ],
      "min_core_len": 3,
      "_min_core_len_note": "★同 US：加拿大清单 621 条里有 26 条主干 ≤3 位（Hisense S7N 等 24 条 3 位、UX 2 条 2 位）。沿用 min_core_len=4 会让 S7N 这类主力系列主干匹配被整条跳过。降到 3 的前提同样是闸三（PDP 权威型号精确相等）成立。主干仅 2 位的 2 条（UX）仍不做主干匹配，判 no_item 属预期。",
      "core_size_tokens": [
        "class",
        "inch",
        "in",
        "\"",
        "series"
      ]
    },
    "reject": {
      "_note": "★加拿大站同样是 marketplace，且同样有开盒/翻新与配件。",
      "title_contains_any": [
        "wall mount",
        "mount",
        "bracket",
        "stand",
        "case",
        "cover",
        "cable",
        "adapter",
        "screen protector",
        "soundbar",
        "projector",
        "open-box",
        "open box",
        "refurbished",
        "pre-owned",
        "preowned",
        "renewed"
      ],
      "url_contains_any": []
    },
    "on_no_match": "skip"
  }
}
