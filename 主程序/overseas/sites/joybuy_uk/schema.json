{
  "anchor": "body",
  "search": {
    "container": "a[href*='/product/'], .product-card, .gl-item",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true,
      "transform": "clean_text"
    },
    "url": {
      "self_attr": "href"
    },
    "batch": {
      "max_candidates": 60
    }
  },
  "price": {
    "currency": "GBP",
    "price": {
      "jsonld": "offers.price",
      "selectors": [
        "[data-price]",
        ".price",
        "[class*='price']"
      ]
    },
    "raw_text": {
      "selectors": [
        "[class*='price']",
        ".price"
      ]
    }
  },
  "match": {
    "strategy": "search_then_verify",
    "verify": {
      "require_model_in": [
        "title"
      ]
    },
    "on_no_match": "skip"
  }
}