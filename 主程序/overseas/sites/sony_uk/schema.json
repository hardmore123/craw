{
  "anchor": "h1",
  "search": {
    "container": "a[href*='/bravia/products/']",
    "sku": {
      "self_attr": "href"
    },
    "title": {
      "self_text": true
    },
    "url": {
      "self_attr": "href"
    },
    "wait_ms": 5000,
    "batch": {
      "keyword_template": "{brand} tv",
      "max_candidates": 30,
      "fallback_per_model": true
    }
  },
  "price": {
    "price": {
      "selectors": [
        "[class*='Price']:not([class*='original'])",
        "[data-testid='product-price']"
      ],
      "transform": "money"
    },
    "currency": {
      "selectors": [
        "[data-testid='currency']"
      ],
      "transform": "currency"
    },
    "list_price": {
      "selectors": [
        "[class*='originalPrice']",
        "[class*='formerPrice']"
      ],
      "transform": "money"
    },
    "in_stock": {
      "selectors": [
        "[data-testid='add-to-cart']",
        "[class*='stock']"
      ],
      "transform": "in_stock"
    },
    "raw_text": {
      "selectors": [
        "[class*='Price']"
      ],
      "transform": "clean_text"
    },
    "api": {
      "url": "/commerceapi/rest/v2/sony-uk/products/{sku}?currency=GBP&lang=en_GB&fields=GWX_FULL",
      "price_field": "priceData.value",
      "stock_field": "stock.stockLevelStatus"
    }
  },
  "product": {
    "title": {
      "selectors": [
        "h1"
      ],
      "transform": "clean_text"
    },
    "brand": {
      "selectors": [
        "[data-testid='brand']",
        "meta[itemprop='brand']"
      ],
      "attr": "content",
      "transform": "brand"
    },
    "model": {
      "kv": {
        "container": "[class*='spec'] tr, [class*='detail'] li",
        "key_contains": "model",
        "value": "td"
      },
      "transform": "clean_text"
    },
    "size": {
      "selectors": [
        "h1"
      ],
      "transform": "size_inch"
    },
    "sku": {
      "selectors": [
        "[data-sku]",
        "input[name='sku']"
      ],
      "attr": "value",
      "transform": "clean_text"
    }
  },
  "reviews": {
    "source": "bazaarvoice_bfd",
    "bv": {
      "client": "sony-global",
      "display_code": "12872_22_0",
      "site": "seu",
      "locale": "en_GB",
      "origin": "https://www.sony.co.uk",
      "content_locale": "en_GB",
      "page_size": 100,
      "max_pages": 20,
      "max_reviews": 1000
    },
    "container": "[class*='bv-content'], [data-bv-show='inline_rating']",
    "limit": 40,
    "fields": {
      "review_key": {
        "self_attr": "id"
      },
      "rating": {
        "selectors": [
          "[itemprop='ratingValue']",
          "[class*='bv-rating']"
        ],
        "transform": "rating"
      },
      "title": {
        "selectors": [
          "[class*='bv-content-title']",
          "[itemprop='name']"
        ],
        "transform": "clean_text"
      },
      "body": {
        "selectors": [
          "[itemprop='reviewBody']",
          "[class*='bv-content-body']"
        ],
        "transform": "clean_text"
      },
      "author": {
        "selectors": [
          "[itemprop='author']",
          "[class*='bv-author']"
        ],
        "transform": "clean_text"
      },
      "review_date": {
        "selectors": [
          "[itemprop='datePublished']",
          "[class*='bv-date']"
        ],
        "transform": "clean_text"
      }
    }
  },
  "summary": {
    "avg_rating": {
      "selectors": [
        "[data-testid='rating'] .avg",
        "[class*='bv-rating']"
      ],
      "transform": "rating"
    },
    "total_count": {
      "selectors": [
        "[data-testid='review-count']",
        "[class*='bv-count']"
      ],
      "transform": "int"
    }
  },
  "match": {
    "strategy": "url_template",
    "url_template": "https://www.sony.co.uk/bravia/products/{slug}?sku={sku}",
    "verify": {
      "require_model_in": [
        "title",
        "sku",
        "url"
      ],
      "normalize": "upper_alnum",
      "allow_core_match": true,
      "core_strip_leading_size": true,
      "min_core_len": 3
    },
    "reject": {
      "title_contains_any": [
        "soundbar",
        "projector",
        "wall mount",
        "mount",
        "bracket",
        "stand",
        "case",
        "cover",
        "remote"
      ]
    },
    "on_no_match": "skip"
  }
}
